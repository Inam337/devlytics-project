# Same-origin /api/v1 → Vite proxies to Nest (recommended)
VITE_API_BASE_URL=/api/v1

# Proxy target (optional; default http://localhost:3000)
VITE_API_PROXY_TARGET=http://localhost:3000

# Direct browser → API (uncomment if you prefer CORS instead of proxy)
# VITE_API_BASE_URL=http://localhost:3000/api/v1
