# Development: leave empty to use Vite proxy (see vite.config.ts)
VITE_API_BASE_URL=

# Optional proxy target when VITE_API_BASE_URL is empty
VITE_API_PROXY_TARGET=http://localhost:3000

# Production build (.env.production) — required; baked into dist/ at build time
# VITE_API_BASE_URL=https://api.your-domain.com
#
# Backend production: set CORS_ORIGINS to your SPA origin(s)
# See frontend/docs/production.md
