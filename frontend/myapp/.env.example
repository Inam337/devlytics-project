# Development: /api/v1 is proxied to Nest (see vite.config.ts)
VITE_API_BASE_URL=/api/v1

# Optional proxy target
VITE_API_PROXY_TARGET=http://localhost:3000

# Production build (.env.production) — required; baked into dist/ at build time
# Include /api/v1 when the backend uses that global prefix
# VITE_API_BASE_URL=https://api.your-domain.com/api/v1
#
# Backend production: set CORS_ORIGINS to your SPA origin(s)
# See frontend/docs/production.md
