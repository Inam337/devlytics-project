  id                     String          @id @default(uuid()) @db.Uuid
  experimentId           String          @map("experiment_id") @db.Uuid
  metricName             String          @map("metric_name") @db.VarChar(100)
  metricKey              String          @map("metric_key") @db.VarChar(100)
  metricType             MetricType      @map("metric_type")
  unit                   String?         @db.VarChar(50)
  direction              MetricDirection
  baselineValue          Decimal?        @map("baseline_value") @db.Decimal(18, 6)
  targetValue            Decimal?        @map("target_value") @db.Decimal(18, 6)
  currentValue           Decimal?        @map("current_value") @db.Decimal(18, 6)
  finalValue             Decimal?        @map("final_value") @db.Decimal(18, 6)
  baselinePeriodStart    DateTime?       @map("baseline_period_start") @db.Timestamptz(6)
  baselinePeriodEnd      DateTime?       @map("baseline_period_end") @db.Timestamptz(6)
  measurementPeriodStart DateTime?       @map("measurement_period_start") @db.Timestamptz(6)
  measurementPeriodEnd   DateTime?       @map("measurement_period_end") @db.Timestamptz(6)
  isPrimary              Boolean         @default(false) @map("is_primary")
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  experiment      EngineeringExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  proofsAsPrimary ImprovementProof[]    @relation("ProofPrimaryMetric")

  @@unique([experimentId, metricKey])
  @@index([experimentId, metricKey])
  @@index([experimentId, isPrimary])
  @@map("tbl_experiment_metric")
}

model ImprovementProof {
  id                    String                @id @default(uuid()) @db.Uuid
  organizationId        String                @map("organization_id") @db.Uuid
  experimentId          String                @unique @map("experiment_id") @db.Uuid
  primaryMetricId       String?               @map("primary_metric_id") @db.Uuid
  verificationStatus    VerificationStatus    @default(PENDING) @map("verification_status")
  baselineValue         Decimal?              @map("baseline_value") @db.Decimal(18, 6)
  finalValue            Decimal?              @map("final_value") @db.Decimal(18, 6)
  targetValue           Decimal?              @map("target_value") @db.Decimal(18, 6)
  improvementPercentage Decimal?              @map("improvement_percentage") @db.Decimal(10, 4)
  targetAchieved        Boolean               @default(false) @map("target_achieved")
  confidence            ExperimentConfidence?
  evidenceSummary       String?               @map("evidence_summary") @db.Text
  evidence              Json?
  resultSummary         String?               @map("result_summary") @db.Text
  verifiedAt            DateTime?             @map("verified_at") @db.Timestamptz(6)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  experiment    EngineeringExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  primaryMetric ExperimentMetric?     @relation("ProofPrimaryMetric", fields: [primaryMetricId], references: [id], onDelete: SetNull)

  @@index([organizationId, verificationStatus])
  @@index([organizationId, verifiedAt])
  @@index([experimentId])
  @@map("tbl_improvement_proof")
}
