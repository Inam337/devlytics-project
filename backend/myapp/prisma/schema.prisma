// Devlytics — PostgreSQL schema (devlytics_db)
// Baseline: docs/Devlytics_Final_Backend_PostgreSQL_API_Requirements.md
// Conventions: UUID primary keys, snake_case columns, `tbl_` table prefix,
// UTC timestamptz, organization_id tenant boundary, JSONB for provider metadata only.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

enum RoleKey {
  ORGANIZATION_ADMIN
  DEPARTMENT_MANAGER
  TEAM_LEAD
  DEVELOPER
  AUDITOR
  BILLING
}

enum TeamStatus {
  ACTIVE
  ARCHIVED
}

enum AvatarType {
  IMAGE
  INITIALS
  ICON
}

enum ProjectStatus {
  ACTIVE
  AT_RISK
  COMPLETED
  ARCHIVED
}

enum GitProviderType {
  GITHUB
  GITLAB
}

enum ProviderStatus {
  CONNECTED
  DISCONNECTED
  TOKEN_EXPIRED
  RATE_LIMITED
}

enum SyncStatus {
  NEVER_SYNCED
  QUEUED
  SYNCING
  SYNCED
  PARTIAL
  FAILED
  DISCONNECTED
}

enum RepositoryVisibility {
  PUBLIC
  PRIVATE
  INTERNAL
}

enum GitIdentityClassification {
  MATCHED
  UNMATCHED
  BOT
}

enum PullRequestStatus {
  DRAFT
  OPEN
  MERGED
  CLOSED
}

enum ReviewState {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  COMMENTED
  DISMISSED
}

enum IssueStatus {
  OPEN
  CLOSED
}

enum PipelineStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  CANCELED
  SKIPPED
}

enum DeploymentStatus {
  IN_PROGRESS
  SUCCESS
  FAILED
  ROLLED_BACK
}

enum MaintainabilityRating {
  A
  B
  C
  D
  E
}

enum ScoreCategory {
  CODE_QUALITY
  DELIVERY
  CODE_REVIEW
  TESTING
  RELIABILITY
  COLLABORATION
  DOCUMENTATION
  PROJECT_IMPACT
}

enum RankingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum RankingSubjectType {
  DEVELOPER
  TEAM
  PROJECT
}

enum ScoreFreshness {
  LIVE
  PARTIAL
  STALE
}

enum AiProviderType {
  OLLAMA
  OPENAI
  CLAUDE
  GEMINI
}

enum AnalysisRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

enum AnalysisScope {
  REPOSITORY
  PROJECT
  ORGANIZATION
}

enum IssueSeverity {
  BLOCKER
  CRITICAL
  MAJOR
  MINOR
  INFO
}

enum QualityCategory {
  DUPLICATION
  PERFORMANCE
  MAINTAINABILITY
  TESTING
  SECURITY
  RELIABILITY
  DOCUMENTATION
  TECHNICAL_DEBT
  ARCHITECTURE
  COMPLEXITY
}

enum QualityIssueStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  WONT_FIX
  FALSE_POSITIVE
}

enum RecommendationStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  IMPLEMENTED
}

enum EffortLevel {
  LOW
  MEDIUM
  HIGH
}

enum ImpactLevel {
  LOW
  MEDIUM
  HIGH
}

enum SelfEvaluationStatus {
  DRAFT
  SUBMITTED
  REVIEWED
}

enum GoalOwnerType {
  DEVELOPER
  TEAM
}

enum GoalStatus {
  ACTIVE
  AT_RISK
  COMPLETED
  ABANDONED
}

enum GoalDirection {
  INCREASE
  DECREASE
}

enum AchievementStatus {
  LOCKED
  IN_PROGRESS
  EARNED
}

enum NotificationCategory {
  TRANSACTIONAL
  DIGEST
  MILESTONE
  ALERT
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum AuditCategory {
  SCORING
  INTEGRATION
  REPOSITORY
  USER
  ROLE
  AI
  ORGANIZATION
  TEAM
  PROJECT
  GOAL
  AUTH
  EXPERIMENT
}

enum SyncJobType {
  FULL_IMPORT
  INCREMENTAL
  WEBHOOK
  RECONCILE
  IDENTITY_MATCH
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  RETRYING
}

// Improvement Engine (docs/Interactive design .../DEVLYTICS-SPEC.md, improvement
// engine addendum): MEASURE → DETECT → EXPLAIN → RECOMMEND → GOAL → EXPERIMENT →
// RE-MEASURE → PROVE. Confidence is never asserted from AI output alone — see
// ImprovementVerificationService.
enum ExperimentStatus {
  DRAFT
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  PROVEN
  FAILED
  CANCELLED
}

enum ExperimentConfidence {
  HIGH
  MEDIUM
  LOW
  INSUFFICIENT_DATA
}

enum MetricType {
  DURATION
  COUNT
  PERCENTAGE
  RATIO
  SCORE
  SIZE
  RATE
}

enum MetricDirection {
  INCREASE
  DECREASE
  TARGET_RANGE
}

enum VerificationStatus {
  PENDING
  ACHIEVED
  PARTIALLY_ACHIEVED
  NOT_ACHIEVED
  INSUFFICIENT_DATA
}

// ---------------------------------------------------------------------------
// Identity & RBAC
// ---------------------------------------------------------------------------

model Organization {
  id                  String             @id @default(uuid()) @db.Uuid
  name                String             @db.VarChar(150)
  slug                String             @unique @db.VarChar(150)
  description         String?            @db.Text
  industry            String?            @db.VarChar(100)
  logoUrl             String?            @map("logo_url") @db.Text
  faviconUrl          String?            @map("favicon_url") @db.Text
  primaryColor        String             @default("#372b73") @map("primary_color") @db.VarChar(16)
  secondaryColor      String             @default("#0B7D9E") @map("secondary_color") @db.VarChar(16)
  timezone            String             @default("UTC") @db.VarChar(64)
  dateFormat          String             @default("YYYY-MM-DD") @map("date_format") @db.VarChar(32)
  currency            String             @default("USD") @db.VarChar(8)
  activeWeightVersion Int                @default(1) @map("active_weight_version")
  onboardingState     Json?              @map("onboarding_state")
  status              OrganizationStatus @default(ACTIVE)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  members           OrganizationUser[]
  roles             Role[]
  departments       Department[]
  teams             Team[]
  teamMembers       TeamMember[]
  projects          Project[]
  projectTeams      ProjectTeam[]
  projectMembers    ProjectMember[]
  gitProviders      GitProvider[]
  gitAccounts       GitAccount[]
  repositories      Repository[]
  repoMembers       RepositoryMember[]
  commits           Commit[]
  pullRequests      PullRequest[]
  reviews           PullRequestReview[]
  issues            Issue[]
  pipelines         CiPipeline[]
  deployments       Deployment[]
  qualitySnapshots  CodeQualitySnapshot[]
  developerMetrics  DeveloperDailyMetric[]
  teamMetrics       TeamDailyMetric[]
  scoringRules      ScoringRule[]
  developerScores   DeveloperScore[]
  teamScores        TeamScore[]
  rankingHistory    RankingHistory[]
  aiProviders       AiProvider[]
  aiIntegrations    AiIntegration[]
  aiUsage           AiUsage[]
  analysisRuns      AiAnalysisRun[]
  qualityIssues     CodeQualityIssue[]
  recommendations   ImprovementRecommendation[]
  selfEvaluations   SelfEvaluation[]
  goals             ImprovementGoal[]
  userAchievements  UserAchievement[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  syncJobs          SyncJob[]
  refreshTokens     RefreshToken[]
  experiments       EngineeringExperiment[]
  improvementProofs ImprovementProof[]

  @@index([status])
  @@index([createdAt])
  @@map("tbl_organization")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  firstName    String     @map("first_name") @db.VarChar(80)
  lastName     String     @map("last_name") @db.VarChar(80)
  email        String     @unique @db.Citext
  passwordHash String?    @map("password_hash") @db.Text
  avatarUrl    String?    @map("avatar_url") @db.Text
  jobTitle     String?    @map("job_title") @db.VarChar(120)
  employeeCode String?    @map("employee_code") @db.VarChar(60)
  status       UserStatus @default(INVITED)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(6)
  lastActiveAt DateTime?  @map("last_active_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships           OrganizationUser[]
  managedDepartments    Department[]              @relation("DepartmentManager")
  ledTeams              Team[]                    @relation("TeamLead")
  teamMemberships       TeamMember[]
  ownedProjects         Project[]                 @relation("ProjectOwner")
  projectMemberships    ProjectMember[]
  gitAccounts           GitAccount[]
  repoMemberships       RepositoryMember[]
  connectedProviders    GitProvider[]             @relation("ProviderConnectedBy")
  commits               Commit[]
  pullRequests          PullRequest[]
  reviews               PullRequestReview[]
  createdIssues         Issue[]                   @relation("IssueCreator")
  assignedIssues        Issue[]                   @relation("IssueAssignee")
  dailyMetrics          DeveloperDailyMetric[]
  scores                DeveloperScore[]
  rankings              RankingHistory[]
  createdScoringRules   ScoringRule[]             @relation("ScoringRuleAuthor")
  aiUsage               AiUsage[]
  requestedRuns         AiAnalysisRun[]           @relation("AnalysisRequestedBy")
  assignedIssuesQuality CodeQualityIssue[]        @relation("QualityIssueAssignee")
  selfEvaluations       SelfEvaluation[]          @relation("SelfEvaluationSubject")
  reviewedEvaluations   SelfEvaluation[]          @relation("SelfEvaluationReviewer")
  ownedGoals            ImprovementGoal[]         @relation("GoalOwner")
  createdGoals          ImprovementGoal[]         @relation("GoalCreatedBy")
  goalProgress          ImprovementGoalProgress[]
  achievements          UserAchievement[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  refreshTokens         RefreshToken[]
  passwordResets        PasswordResetToken[]
  requestedSyncJobs     SyncJob[]                 @relation("SyncJobRequestedBy")
  experiments           EngineeringExperiment[]   @relation("ExperimentOwner")
  createdExperiments    EngineeringExperiment[]   @relation("ExperimentCreatedBy")

  @@index([status])
  @@index([lastActiveAt])
  @@map("tbl_user")
}

model OrganizationUser {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  roleId         String           @map("role_id") @db.Uuid
  status         MembershipStatus @default(INVITED)
  invitedAt      DateTime?        @map("invited_at") @db.Timestamptz(6)
  joinedAt       DateTime?        @map("joined_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([organizationId, roleId])
  @@index([userId])
  @@map("tbl_organization_user")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            RoleKey
  name           String   @db.VarChar(80)
  description    String?  @db.Text
  isSystem       Boolean  @default(true) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  memberships  OrganizationUser[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("tbl_role")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(120)
  resource    String   @db.VarChar(60)
  action      String   @db.VarChar(40)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@index([resource])
  @@map("tbl_permission")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("tbl_role_permission")
}

model RefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.VarChar(128)
  familyId       String    @map("family_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById   String?   @map("replaced_by_id") @db.Uuid
  userAgent      String?   @map("user_agent") @db.VarChar(255)
  ipAddress      String?   @map("ip_address") @db.VarChar(64)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("tbl_refresh_token")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("tbl_password_reset_token")
}

// ---------------------------------------------------------------------------
// Organization structure
// ---------------------------------------------------------------------------

model Department {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(120)
  code           String   @db.VarChar(40)
  description    String?  @db.Text
  managerId      String?  @map("manager_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  manager      User?        @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  teams        Team[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("tbl_department")
}

model Team {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  departmentId   String?    @map("department_id") @db.Uuid
  name           String     @db.VarChar(120)
  code           String     @db.VarChar(40)
  description    String?    @db.Text
  avatarUrl      String?    @map("avatar_url") @db.Text
  avatarType     AvatarType @default(INITIALS) @map("avatar_type")
  teamColor      String     @default("#372b73") @map("team_color") @db.VarChar(16)
  teamLeadId     String?    @map("team_lead_id") @db.Uuid
  status         TeamStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department    Department?             @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teamLead      User?                   @relation("TeamLead", fields: [teamLeadId], references: [id], onDelete: SetNull)
  members       TeamMember[]
  projectTeams  ProjectTeam[]
  repositories  Repository[]
  dailyMetrics  TeamDailyMetric[]
  scores        TeamScore[]
  rankings      RankingHistory[]
  aiUsage       AiUsage[]
  qualityIssues CodeQualityIssue[]      @relation("QualityIssueTeam")
  goals         ImprovementGoal[]       @relation("GoalTeam")
  experiments   EngineeringExperiment[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, departmentId])
  @@map("tbl_team")
}

model TeamMember {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  teamId         String   @map("team_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  positionTitle  String?  @map("position_title") @db.VarChar(120)
  isLead         Boolean  @default(false) @map("is_lead")
  joinedAt       DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([organizationId, userId])
  @@index([teamId])
  @@map("tbl_team_member")
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

model Project {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  name            String        @db.VarChar(150)
  code            String        @db.VarChar(40)
  projectKey      String?       @map("project_key") @db.VarChar(40)
  description     String?       @db.Text
  status          ProjectStatus @default(ACTIVE)
  progressPercent Decimal       @default(0) @map("progress_percent") @db.Decimal(5, 2)
  startDate       DateTime?     @map("start_date") @db.Date
  endDate         DateTime?     @map("end_date") @db.Date
  ownerId         String?       @map("owner_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner            User?                   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  teams            ProjectTeam[]
  members          ProjectMember[]
  repositories     Repository[]
  qualitySnapshots CodeQualitySnapshot[]
  aiUsage          AiUsage[]
  analysisRuns     AiAnalysisRun[]
  selfEvaluations  SelfEvaluation[]
  experiments      EngineeringExperiment[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("tbl_project")
}

model ProjectTeam {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  teamId         String   @map("team_id") @db.Uuid
  isPrimary      Boolean  @default(false) @map("is_primary")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([projectId, teamId])
  @@index([organizationId, teamId])
  @@map("tbl_project_team")
}

model ProjectMember {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  roleLabel         String?  @map("role_label") @db.VarChar(80)
  allocationPercent Int      @default(100) @map("allocation_percent")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([organizationId, userId])
  @@map("tbl_project_member")
}

// ---------------------------------------------------------------------------
// Git integration
// ---------------------------------------------------------------------------

model GitProvider {
  id                     String          @id @default(uuid()) @db.Uuid
  organizationId         String          @map("organization_id") @db.Uuid
  providerType           GitProviderType @map("provider_type")
  displayName            String          @map("display_name") @db.VarChar(120)
  baseUrl                String          @default("https://api.github.com") @map("base_url") @db.Text
  externalAccountId      String?         @map("external_account_id") @db.VarChar(120)
  externalAccountName    String?         @map("external_account_name") @db.VarChar(160)
  accessTokenEncrypted   String?         @map("access_token_encrypted") @db.Text
  refreshTokenEncrypted  String?         @map("refresh_token_encrypted") @db.Text
  tokenExpiresAt         DateTime?       @map("token_expires_at") @db.Timestamptz(6)
  scopes                 String[]        @default([])
  webhookSecretEncrypted String?         @map("webhook_secret_encrypted") @db.Text
  status                 ProviderStatus  @default(CONNECTED)
  lastSyncAt             DateTime?       @map("last_sync_at") @db.Timestamptz(6)
  lastErrorMessage       String?         @map("last_error_message") @db.Text
  connectedById          String?         @map("connected_by_id") @db.Uuid
  metadata               Json?
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedBy  User?        @relation("ProviderConnectedBy", fields: [connectedById], references: [id], onDelete: SetNull)
  accounts     GitAccount[]
  repositories Repository[]
  syncJobs     SyncJob[]

  @@unique([organizationId, providerType, externalAccountId])
  @@index([organizationId, status])
  @@map("tbl_git_provider")
}

model GitAccount {
  id             String                    @id @default(uuid()) @db.Uuid
  organizationId String                    @map("organization_id") @db.Uuid
  providerId     String                    @map("provider_id") @db.Uuid
  userId         String?                   @map("user_id") @db.Uuid
  externalUserId String?                   @map("external_user_id") @db.VarChar(120)
  username       String                    @db.VarChar(160)
  commitEmail    String?                   @map("commit_email") @db.Citext
  avatarUrl      String?                   @map("avatar_url") @db.Text
  classification GitIdentityClassification @default(UNMATCHED)
  isBot          Boolean                   @default(false) @map("is_bot")
  matchedAt      DateTime?                 @map("matched_at") @db.Timestamptz(6)
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider     GitProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([providerId, username])
  @@index([organizationId, classification])
