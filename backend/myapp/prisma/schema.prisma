model RankingHistory {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  subjectType    RankingSubjectType @map("subject_type")
  // Always populated with the ranked subject's id (user or team). Kept alongside the
  // nullable FKs because PostgreSQL treats NULLs as distinct, which would make a
  // unique constraint over the nullable columns unenforceable.
  subjectId      String             @map("subject_id") @db.Uuid
  userId         String?            @map("user_id") @db.Uuid
  teamId         String?            @map("team_id") @db.Uuid
  period         RankingPeriod
  periodStart    DateTime           @map("period_start") @db.Date
  periodEnd      DateTime           @map("period_end") @db.Date
  weightVersion  Int                @map("weight_version")
  rank           Int
  previousRank   Int?               @map("previous_rank")
  rankDelta      Int                @default(0) @map("rank_delta")
  score          Decimal            @default(0) @db.Decimal(6, 2)
  totalSubjects  Int                @default(0) @map("total_subjects")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

