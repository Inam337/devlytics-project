# Server
PORT=3000

# PostgreSQL (defaults match src/config/database.config.ts)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=root
DB_NAME=ShopDB

# CORS — comma-separated frontend origins (browser calls)
# Dev default in main.ts: localhost:5173 and :4173 if unset
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT (required for auth)
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
