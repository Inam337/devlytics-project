# ---------------------------------------------------------------------------
# Devlytics backend — environment template. Copy to .env and fill in real values.
# Never commit a populated .env.
# ---------------------------------------------------------------------------

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME=Devlytics
APP_URL=http://localhost:3000
LOG_LEVEL=log

# CORS — comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (devlytics_db)
# Host port 5433 maps to the compose Postgres container (avoids a local 5432 clash).
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=devlytics_db
DATABASE_USER=devlytics
DATABASE_PASSWORD=devlytics_local_pw
DATABASE_SCHEMA=public
# Prisma reads this single URL; it must stay consistent with the parts above.
DATABASE_URL=postgresql://devlytics:devlytics_local_pw@localhost:5433/devlytics_db?schema=public

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0
QUEUE_PREFIX=devlytics

# JWT
JWT_SECRET=change-me-access-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_RESET_EXPIRES_MINUTES=30

# Encryption for stored Git/AI credentials (32-byte key, hex or base64)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Rate limiting
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# GitHub integration
GITHUB_API_URL=https://api.github.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_SCOPES=repo:read,org:read,actions:read

# GitLab integration
GITLAB_API_URL=https://gitlab.com/api/v4
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_WEBHOOK_SECRET=
GITLAB_SCOPES=read_api,read_repository

# AI — local-first. External providers are opt-in per organization.
AI_DEFAULT_PROVIDER=OLLAMA
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
AI_REQUEST_TIMEOUT_MS=120000
AI_SANITIZE_CONTEXT=true
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Sync
SYNC_HISTORY_MONTHS=12
SYNC_RECONCILE_INTERVAL_MINUTES=5
GOAL_AT_RISK_DAYS=14
INACTIVITY_SUSPEND_DAYS=90
